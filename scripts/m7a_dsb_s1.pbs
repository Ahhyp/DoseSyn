#!/bin/bash
#PBS -N m7a_dsb_a
#PBS -l nodes=node4:ppn=4
#PBS -q gentai
#PBS -l walltime=05:00:00
exec > /home/kouzheng_2/AH_YeP/DoseSyn/outputs/logs/pbs_m7a_dsb_a.log 2>&1

cd /home/kouzheng_2/AH_YeP/DoseSyn
export CUDA_VISIBLE_DEVICES=0
for seed in 13 42 2026; do
  .venv/bin/python src/dosesyn/baselines/external/deepsynba_adapter.py \
    --scenario s1_random_condition --seed "$seed" --epochs 60 --patience 10 \
    --batch-size 512 --device cuda --out "outputs/runs/m7a/deepsynba/s1_random_condition/seed_${seed}/predictions.parquet"
done
