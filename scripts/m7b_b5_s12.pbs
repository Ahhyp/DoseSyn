cd /home/kouzheng_2/AH_YeP/DoseSyn || exit 1
exec > outputs/logs/pbs_m7b_b5_s12.log 2>&1
export CUDA_VISIBLE_DEVICES=0
export OMP_NUM_THREADS=4
for sc in s1_random_condition s2_unseen_pair; do
