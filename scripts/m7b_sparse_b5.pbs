#!/bin/bash
#PBS -N m7b_sparse_b5
#PBS -q gentai
#PBS -l nodes=node4:ppn=4
#PBS -l walltime=08:00:00
#PBS -j oe
cd /home/kouzheng_2/AH_YeP/DoseSyn || exit 1
exec > outputs/logs/pbs_m7b_sparse_b5.log 2>&1
export CUDA_VISIBLE_DEVICES=0
export OMP_NUM_THREADS=4
.venv/bin/python -u scripts/18_run_m7b.py --group sparse_dev --model m6b_b5_film --force || true
.venv/bin/python -u scripts/18_run_m7b.py --group boundary_dev --model m6b_b5_film --force || true
